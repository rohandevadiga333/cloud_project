# =============================================================
# Student Result Management System – Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL (Local Development) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_result_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ─── PostgreSQL (Azure – fill in before Azure deployment) ─────
# DB_HOST=your-server.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=student_result_db
# DB_USER=your_azure_db_user@your-server
# DB_PASSWORD=your_azure_db_password
# DB_SSL=true

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=8h

# ─── Session ──────────────────────────────────────────────────
SESSION_SECRET=replace_with_another_long_random_secret_string

# ─── App ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
COLLEGE_NAME=Academic Institution
